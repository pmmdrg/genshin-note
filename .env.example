# ==============================================================================
# Genshin Note - Environment Configuration Template
# Sao chép file này thành .env.local để sử dụng cục bộ:
# copy .env.example .env.local
#
# Khi deploy lên Vercel: Thêm các biến này vào Project Settings -> Environment Variables
# ==============================================================================

# [BẢO MẬT] Mã PIN cá nhân của bạn (ví dụ: 123456 hoặc một mật mã ngắn bất kỳ)
# Bất kỳ ai vào web của bạn nếu không biết mã PIN này sẽ KHÔNG thể gọi API Vercel
APP_PIN=123456

# [TÙY CHỌN] Cookie HoYoLAB cá nhân của bạn (lấy từ https://www.hoyolab.com)
# Định dạng: ltuid_v2=...; ltoken_v2=...;
# Nếu đặt ở biến môi trường Vercel, bạn không cần phải nhập cookie trên giao diện web.
HOYOLAB_COOKIE=

# [TÙY CHỌN] In-game Genshin UID của bạn (ví dụ: 812345678)
HOYOLAB_UID=

# Server game (os_asia, os_usa, os_euro, os_cht)
HOYOLAB_SERVER=os_asia
